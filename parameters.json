{
  "RoleType": "DataPipeline",
  "RoleName": "data-pipeline-role",
  "Environment": "devl",
  "AssumeRolePrincipal": "lambda.amazonaws.com",
  "EnableS3Policy": "true",
  "EnableKinesisPolicy": "false",
  "EnableDynamoDBPolicy": "false",
  "EnableGluePolicy": "true",
  "EnableAthenaPolicy": "true",
  "EnableLambdaPolicy": "false",
  "EnableStepFunctionsPolicy": "false",
  "EnableECSPolicy": "false",
  "EnableCodeBuildPolicy": "false",
  "EnableSQSPolicy": "false",
  "EnableSNSPolicy": "false",
  "EnableEventBridgePolicy": "false",
  "EnableAPIGatewayPolicy": "false",
  "EnableSecretsManagerPolicy": "true",
  "EnableCloudWatchPolicy": "true",
  "EnableXRayPolicy": "false",
  "EnableCloudTrailPolicy": "false",
  "EnableCrossAccountAccess": "false",
  "CrossAccountId": "",
  "EnableKMSPolicy": "true",
  "EnableTagging": "true",
  "S3BucketArn": "arn:aws:s3:::my-data-lake-*",
  "KinesisStreamArn": "arn:aws:kinesis:us-east-1:123456789012:stream/my-stream",
  "DynamoDBTableArn": "arn:aws:dynamodb:us-east-1:123456789012:table/my-table",
  "GlueJobArn": "arn:aws:glue:us-east-1:123456789012:job/my-etl-job",
  "GlueCatalogArn": "arn:aws:glue:us-east-1:123456789012:catalog",
  "GlueDatabaseArn": "arn:aws:glue:us-east-1:123456789012:database/my-database",
  "GlueTableArn": "arn:aws:glue:us-east-1:123456789012:table/my-database/my-table",
  "AthenaWorkgroupArn": "arn:aws:athena:us-east-1:123456789012:workgroup/primary",
  "AthenaQueryResultsArn": "arn:aws:s3:::aws-athena-query-results-123456789012-us-east-1/*",
  "LambdaFunctionArn": "arn:aws:lambda:us-east-1:123456789012:function:my-function",
  "StepFunctionsStateMachineArn": "arn:aws:states:us-east-1:123456789012:stateMachine:my-state-machine",
  "StepFunctionsExecutionArn": "arn:aws:states:us-east-1:123456789012:execution:my-state-machine:*",
  "ECSTaskArn": "arn:aws:ecs:us-east-1:123456789012:task/*",
  "ECSTaskDefinitionArn": "arn:aws:ecs:us-east-1:123456789012:task-definition/my-task:*",
  "IAMRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "CodeBuildProjectArn": "arn:aws:codebuild:us-east-1:123456789012:project/my-project",
  "SQSQueueArn": "arn:aws:sqs:us-east-1:123456789012:my-queue",
  "SNSTopicArn": "arn:aws:sns:us-east-1:123456789012:my-topic",
  "EventBridgeArn": "arn:aws:events:us-east-1:123456789012:event-bus/default",
  "SecretsManagerArn": "arn:aws:secretsmanager:us-east-1:123456789012:secret:devl/*",
  "CloudWatchLogsArn": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/my-function",
  "KMSKeyArn": "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012",
  "CrossAccountRoleArn": "*"
}
